═══════════════════════════════════════════ -->
<div id="intro-overlay" role="dialog" aria-label="Wedding invitation opening animation" aria-modal="true">
  <button id="skip-intro-btn" aria-label="Skip introduction animation">Skip Intro ›</button>

  <div id="envelope-wrapper">
    <!-- Floating petals -->
    <div class="petal petal-1" aria-hidden="true"></div>
    <div class="petal petal-2" aria-hidden="true"></div>
    <div class="petal petal-3" aria-hidden="true"></div>
    <div class="petal petal-4" aria-hidden="true"></div>
    <div class="petal petal-5" aria-hidden="true"></div>
    <div class="petal petal-6" aria-hidden="true"></div>

    <!-- Gold particles -->
    <div class="particles" aria-hidden="true">
      <span class="particle"></span><span class="particle"></span>
      <span class="particle"></span><span class="particle"></span>
      <span class="particle"></span><span class="particle"></span>
      <span class="particle"></span><span class="particle"></span>
    </div>

    <div id="envelope" role="button" tabindex="0" aria-label="Click to open wedding invitation">
      <!-- Envelope flap -->
      <div id="env-flap">
        <div class="env-kolam" aria-hidden="true">
          <svg viewBox="0 0 80 50" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="40" cy="25" r="6" stroke="#B79555" stroke-width="1"/>
            <circle cx="40" cy="25" r="12" stroke="#B79555" stroke-width="0.6" stroke-dasharray="2 3"/>
            <circle cx="40" cy="25" r="18" stroke="#B79555" stroke-width="0.4" stroke-dasharray="1 4"/>
            <line x1="40" y1="7" x2="40" y2="43" stroke="#B79555" stroke-width="0.5"/>
            <line x1="22" y1="25" x2="58" y2="25" stroke="#B79555" stroke-width="0.5"/>
            <line x1="28" y1="11" x2="52" y2="39" stroke="#B79555" stroke-width="0.3"/>
            <line x1="52" y1="11" x2="28" y2="39" stroke="#B79555" stroke-width="0.3"/>
            <circle cx="40" cy="7" r="2" fill="#B79555"/>
            <circle cx="40" cy="43" r="2" fill="#B79555"/>
            <circle cx="22" cy="25" r="2" fill="#B79555"/>
            <circle cx="58" cy="25" r="2" fill="#B79555"/>
          </svg>
        </div>
        <div class="env-wax-seal" aria-hidden="true">
          <span>ஸ்ரீ</span>
        </div>
      </div>

      <!-- Envelope body -->
      <div id="env-body">
        <div class="env-left-fold"></div>
        <div class="env-right-fold"></div>
        <div class="env-bottom-fold"></div>

        <!-- Card inside envelope -->
        <div id="env-card">
          <p class="env-card-tamil" lang="ta">திருமண வரவேற்பு விழா</p>
          <div class="env-card-divider" aria-hidden="true"></div>
          <p class="env-card-names">N. Shanmugasundaram</p>
          <p class="env-card-with">weds</p>
          <p class="env-card-names">R. Srimathi</p>
          <p class="env-card-date">16 · November · 2026</p>
        </div>
      </div>
    </div>

    <p id="env-hint" aria-hidden="true">Tap to open your invitation</p>
  </div>
</div>

