      <!-- Wishes form (client-side only — no backend required) -->
      <form id="wishes-form" class="wishes-form reveal-up" novalidate aria-label="Wedding wishes form">
        <div class="form-note" data-en="Note: Wishes are stored locally in your browser." data-ta="குறிப்பு: வாழ்த்துக்கள் உங்கள் உலாவியில் உள்ளூரில் சேமிக்கப்படுகின்றன.">Note: Wishes are stored locally in your browser.</div>
        <div class="form-group">
          <label for="wish-name" data-en="Your Name" data-ta="உங்கள் பெயர்">Your Name</label>
          <input type="text" id="wish-name" name="name" placeholder="Enter your name" autocomplete="name" required />
        </div>
        <div class="form-group">
          <label for="wish-message" data-en="Your Message" data-ta="உங்கள் செய்தி">Your Message</label>
          <textarea id="wish-message" name="message" rows="4" placeholder="Write your wishes for the couple..." required></textarea>
        </div>
        <div class="form-group form-group-inline">
          <label class="form-check-label">
            <input type="checkbox" id="wish-attending" name="attending" />
            <span data-en="I will be attending the reception" data-ta="நான் வரவேற்பு விழாவில் கலந்துகொள்வேன்">I will be attending the reception</span>
          </label>
        </div>
        <button type="submit" class="btn-primary" data-en="Send Wishes ♥" data-ta="வாழ்த்துக்கள் அனுப்பு ♥">Send Wishes ♥</button>
      </form>

      <!-- Wishes display -->
      <div id="wishes-display" class="wishes-display reveal-up" aria-live="polite" aria-label="Guest wishes"></div>

      <!-- Contact info -->
      <div class="contact-info reveal-up">
        <h3 class="contact-title" data-en="Contact" data-ta="தொடர்பு">Contact</h3>
        <div class="contact-grid">
          <div class="contact-card">
            <p class="contact-family" data-en="Bride's Family" data-ta="மணமகளின் குடும்பம்">Bride's Family</p>
            <a href="tel:+917598429215" class="contact-phone">+91 75984 29215</a>
            <a href="tel:+919443929215" class="contact-phone">+91 94439 29215</a>
          </div>
          <div class="contact-card">
            <p class="contact-family" data-en="Groom's Family" data-ta="மணமகனின் குடும்பம்">Groom's Family</p>
            <a href="tel:+919688813018" class="contact-phone">+91 96888 13018</a>
          </div>
        </div>
      </div>
    </div>
  </section>

